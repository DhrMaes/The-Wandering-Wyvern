@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%90%89%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@500;600;700&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @if (IsOverviewPage)
    {
        <div id="app-loading" class="app-loading" role="status" aria-live="polite">
            <div class="app-loading-spinner" aria-hidden="true"></div>
            <div>
                <strong>The Wandering Wyvern</strong>
                <span>De viewer wordt geladen...</span>
            </div>
        </div>
    }
    <Routes />
    <script>
        window.wanderingWyvern = window.wanderingWyvern || {};
        window.wanderingWyvern.hideLoading = function (markClientReady = true) {
            const loading = document.getElementById("app-loading");
            if (loading) {
                loading.classList.add("is-hidden");
            }
            if (markClientReady) {
                sessionStorage.setItem("wandering-wyvern-client-ready", "true");
            }
        };
        window.wanderingWyvern.saveOverviewScroll = function () {
            if (window.location.pathname.replace(/\/+$/, "") === "" &&
                !window.wanderingWyvern.isRestoringOverviewScroll) {
                sessionStorage.setItem("wandering-wyvern-overview-scroll", String(window.scrollY));
            }
        };
        window.wanderingWyvern.restoreOverviewScroll = function () {
            const overviewScrollKey = "wandering-wyvern-overview-scroll";
            const savedScroll = Number.parseInt(sessionStorage.getItem(overviewScrollKey) ?? "", 10);
            if (!Number.isFinite(savedScroll) || savedScroll <= 0) {
                return;
            }

            window.wanderingWyvern.isRestoringOverviewScroll = true;
            sessionStorage.removeItem(overviewScrollKey);
            window.requestAnimationFrame(function () {
                window.requestAnimationFrame(function () {
                    window.scrollTo(0, savedScroll);
                    window.setTimeout(function () {
                        window.wanderingWyvern.isRestoringOverviewScroll = false;
                    }, 100);
                });
            });
        };
        const hideReadyLoadingOverlay = function () {
            if (sessionStorage.getItem("wandering-wyvern-client-ready") === "true") {
                window.wanderingWyvern.hideLoading(false);
            }
        };
        document.addEventListener("enhancedload", hideReadyLoadingOverlay);
        new MutationObserver(hideReadyLoadingOverlay).observe(document.documentElement, {
            childList: true,
            subtree: true
        });

        const normalizedPath = window.location.pathname.replace(/\/+$/, "");
        const isOverviewPage = normalizedPath === "";
        const isHelpPage = normalizedPath === "/help";
        const clientWasAlreadyReady = sessionStorage.getItem("wandering-wyvern-client-ready") === "true";
        const navigationMedia = window.matchMedia("(max-width: 700px)");
        document.querySelectorAll(".nav-drawer-toggle").forEach(function (toggle) {
            toggle.addEventListener("click", function () {
                if (!navigationMedia.matches) {
                    return;
                }

                const drawer = toggle.closest(".nav-drawer");
                const isOpen = drawer.classList.toggle("is-open");
                toggle.setAttribute("aria-expanded", String(isOpen));
            });
        });
        const syncNavigationDrawer = function () {
            document.querySelectorAll(".nav-drawer").forEach(function (drawer) {
                const toggle = drawer.querySelector(".nav-drawer-toggle");
                if (navigationMedia.matches) {
                    drawer.classList.remove("is-open");
                    toggle?.setAttribute("aria-expanded", "false");
                } else {
                    drawer.classList.add("is-open");
                    toggle?.setAttribute("aria-expanded", "true");
                }
            });
        };
        syncNavigationDrawer();
        navigationMedia.addEventListener("change", syncNavigationDrawer);

        if ("scrollRestoration" in history) {
            history.scrollRestoration = "manual";
        }

        window.addEventListener("scroll", window.wanderingWyvern.saveOverviewScroll, { passive: true });
        window.addEventListener("pagehide", window.wanderingWyvern.saveOverviewScroll);
        document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "hidden") {
                window.wanderingWyvern.saveOverviewScroll();
            }
        });

        if (!isOverviewPage || isHelpPage || clientWasAlreadyReady) {
            window.wanderingWyvern.hideLoading(false);
        }
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private bool IsOverviewPage =>
        new Uri(Navigation.Uri).AbsolutePath.Trim('/').Length == 0;
}
