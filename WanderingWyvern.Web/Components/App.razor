@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@500;600;700&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @if (IsOverviewPage)
    {
        <div id="app-loading" class="app-loading" role="status" aria-live="polite">
            <div class="app-loading-spinner" aria-hidden="true"></div>
            <div>
                <strong>The Wandering Wyvern</strong>
                <span>De viewer wordt geladen...</span>
            </div>
        </div>
    }
    <Routes />
    <script>
        window.wanderingWyvern = window.wanderingWyvern || {};
        window.wanderingWyvern.hideLoading = function (markClientReady = true) {
            const loading = document.getElementById("app-loading");
            if (loading) {
                loading.classList.add("is-hidden");
            }
            if (markClientReady) {
                sessionStorage.setItem("wandering-wyvern-client-ready", "true");
            }
        };

        const normalizedPath = window.location.pathname.replace(/\/+$/, "");
        const isOverviewPage = normalizedPath === "";
        const isHelpPage = normalizedPath === "/help";
        const clientWasAlreadyReady = sessionStorage.getItem("wandering-wyvern-client-ready") === "true";
        if (!isOverviewPage || isHelpPage || clientWasAlreadyReady) {
            window.wanderingWyvern.hideLoading(false);
        }
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private bool IsOverviewPage =>
        new Uri(Navigation.Uri).AbsolutePath.Trim('/').Length == 0;
}
