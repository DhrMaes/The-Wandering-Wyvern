    private async Task LogCombatEventAsync(string message)
    {
        if (OnLogEvent.HasDelegate)
        {
            await OnLogEvent.InvokeAsync(message);
        }
        else if (!string.IsNullOrEmpty(SessionSlug))
        {
            await CampaignState.AppendNoteAsync(SessionSlug, message);
        }
    }
}
