@implements IAsyncDisposable
@inject CampaignClientState CampaignState
@inject CampaignMarkdownRenderer Renderer
@inject IJSRuntime JS

<div @ref="_contentElement" class="campaign-reference-content">
    @((MarkupString)(Html ?? string.Empty))
</div>

@if (_modalDocument is not null)
{
    <div class="campaign-reference-backdrop" @onclick="CloseModal">
        <section class="campaign-reference-modal" role="dialog" aria-modal="true" aria-labelledby="campaign-reference-title" @onclick:stopPropagation>
            <div class="campaign-reference-modal-header">
                <h2 id="campaign-reference-title">@_modalDocument.Title</h2>
                <button type="button" class="campaign-reference-close" aria-label="Sluiten" @onclick="CloseModal">×</button>
            </div>
            <div class="campaign-reference-modal-body">
                <CampaignReferenceContent Html="@_modalHtml" />
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public string? Html { get; set; }

    private ElementReference _contentElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CampaignReferenceContent>? _dotNetReference;
    private CampaignDocument? _modalDocument;
    private string? _modalHtml;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/campaignReferences.js");
        _dotNetReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachReferenceLinks", _contentElement, _dotNetReference);
    }

    [JSInvokable]
    public async Task OpenReference(string relativePath)
    {
        var normalizedPath = Uri.UnescapeDataString(relativePath).Trim('/');
        var document = CampaignState.Current?.FindDocument(normalizedPath);
        if (document is null || CampaignState.Current is null)
            return;

        _modalDocument = document;
        _modalHtml = await Renderer.RenderToHtmlAsync(document, CampaignState.Current);
        await InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        _modalDocument = null;
        _modalHtml = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("detachReferenceLinks", _contentElement);
            await _module.DisposeAsync();
        }

        _dotNetReference?.Dispose();
    }
}
