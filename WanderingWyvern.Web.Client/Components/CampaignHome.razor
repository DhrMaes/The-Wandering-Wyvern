@namespace DhrMaes.WanderingWyvern.Web.Client.Components
@implements IDisposable
@inject CampaignClientState CampaignState
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using DhrMaes.WanderingWyvern.Core.Services

<PageTitle>The Wandering Wyvern</PageTitle>

<div class="page-container @(CampaignState.Current is not null ? "campaign-home-ready" : string.Empty)">
    <CampaignFolderPicker />

    @if (CampaignState.Current is { } index)
    {
        <div class="hero">
            <div class="hero-header">
                <div class="hero-text">
                    <h1>@index.CampaignTitle</h1>
                    <p>The Wandering Wyvern — alles wat je nodig hebt aan tafel, op één plek.</p>
                </div>
                <div class="hero-actions">
                    <a class="btn-secondary btn-sm" href="/campaign-info" title="Campagne-informatie bekijken of bewerken">
                        @(index.Readme is not null ? "Campagne-info" : "Campagne-info instellen")
                    </a>
                </div>
            </div>
            <div class="stat-row">
                <div class="stat-pill"><strong>@index.Sessions.Count</strong> sessies</div>
                <div class="stat-pill"><strong>@index.Npcs.Count</strong> NPCs</div>
                <div class="stat-pill"><strong>@index.Locations.Count</strong> locaties</div>
                <div class="stat-pill"><strong>@index.Items.Count</strong> items</div>
            </div>
        </div>

        <div class="entity-list-header">
            <h2 id="sessions">Sessies</h2>
            <button class="btn-secondary btn-sm" @onclick="CreateNewSession" title="Nieuwe sessie toevoegen">
                + Toevoegen
            </button>
        </div>
        @if (index.Sessions.Count == 0)
        {
            <p class="empty-state">Nog geen sessies gevonden.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var session in index.Sessions)
                {
                    <a class="session-card" href="@($"/session/{session.Slug}")">
                        <div class="session-card-title">📖 @session.Title</div>
                        <div class="session-card-meta">@session.Slug</div>
                    </a>
                }
            </div>
        }

        <EntityList Id="npcs" Title="NPCs" Entities="index.Npcs" FolderName="NPCs" PlaceholderIcon="👤" />
        <EntityList Id="locations" Title="Locaties" Entities="index.Locations" FolderName="Locations" PlaceholderIcon="📍" />
        <EntityList Id="lore" Title="Lore" Entities="index.Lore" FolderName="Lore" PlaceholderIcon="📜" />
        <EntityList Id="pcs" Title="Personages (PCs)" Entities="index.Pcs" FolderName="PCs" PlaceholderIcon="🛡️" />
        <EntityList Id="items" Title="Items" Entities="index.Items" FolderName="Items" PlaceholderIcon="💎" />
        <EntityList Id="handouts" Title="Handouts" Entities="index.Handouts" FolderName="Handouts" PlaceholderIcon="📋" />
        
        <EntityCreateModal @ref="_createModal" />
        <CampaignSetupModal @ref="_setupModal" />
    }
</div>

@code {
    private bool _scrollRestorationRequested;
    private bool _hasCheckedInitialSetup;
    private EntityCreateModal _createModal = default!;
    private CampaignSetupModal _setupModal = default!;

    protected override void OnInitialized()
    {
        CampaignState.Changed += HandleChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollRestorationRequested && CampaignState.Current is not null)
        {
            _scrollRestorationRequested = true;
            await JS.InvokeVoidAsync("wanderingWyvern.restoreOverviewScroll");
        }

        if (!_hasCheckedInitialSetup && CampaignState.NeedsInitialSetup)
        {
            _hasCheckedInitialSetup = true;
            await _setupModal.ShowAsync(isInitial: true);
        }
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private async Task CreateNewSession()
    {
        var result = await _createModal.ShowAsync("Sessie", "Sessies");
        if (result == null || string.IsNullOrWhiteSpace(result.Title))
        {
            return;
        }

        var title = result.Title;
        var rawSlug = title.ToLowerInvariant()
            .Replace(" ", "-")
            .Replace("'", "")
            .Replace("\"", "")
            .Replace(":", "")
            .Replace("?", "")
            .Replace("!", "");

        var nextSessionNumber = (CampaignState.Current?.Sessions.Count ?? 0) + 1;
        var slug = $"session-{nextSessionNumber:D2}-{rawSlug}";

        var outlinePath = $"Sessions/{slug}/outline.md";
        var scriptPath = $"Sessions/{slug}/script.md";
        var liveNotesPath = $"Sessions/{slug}/live-notes.md";

        var template = SessionFlowTemplates.GetTemplate(result.SessionTemplate);
        var dateLine = string.IsNullOrWhiteSpace(result.SessionDate) ? $"**Datum:** {DateTime.Now:yyyy-MM-dd}" : $"**Datum:** {result.SessionDate}";
        var locationLine = string.IsNullOrWhiteSpace(result.SessionLocation) ? "" : $"**Startlocatie:** {result.SessionLocation}\n";

        var outlineContent = $@"# Sessie {nextSessionNumber} — {title}

**Sessie:** {nextSessionNumber}
{dateLine}
{locationLine}
{(string.IsNullOrWhiteSpace(result.SessionObjective) ? "" : $"## Doel van deze sessie\n- {result.SessionObjective}\n\n")}{template.DefaultOutlineMarkdown.Trim()}
";

        var scriptContent = $@"# Sessie {nextSessionNumber} — {title} (Script)

{dateLine}
*Regie- en voorleesscript voor de DM. Zie ook `outline.md`.*

{template.DefaultScriptMarkdown.Trim()}
";

        var liveNotesContent = $@"# Live Notes — Sessie {nextSessionNumber} ({title})

*Tijdens het spelen via The Wandering Wyvern worden gekozen paden en notities hier automatisch bijgehouden.*
";

        await CampaignState.WriteDocumentAsync(outlinePath, outlineContent);
        await CampaignState.WriteDocumentAsync(scriptPath, scriptContent);
        await CampaignState.WriteDocumentAsync(liveNotesPath, liveNotesContent);

        NavigationManager.NavigateTo($"/session/{slug}?tab=flow");
    }

    public void Dispose()
    {
        CampaignState.Changed -= HandleChanged;
    }
}
