@implements IDisposable
@inject CampaignClientState CampaignState
@inject CampaignMarkdownRenderer Renderer

<PageTitle>@(_document?.Title ?? RelativePath)</PageTitle>

<div class="page-container">
    <a class="back-link" href="/">&larr; Terug naar overzicht</a>

    @if (CampaignState.Current is null)
    {
        <CampaignFolderPicker />
    }
    else if (_document is null)
    {
        <p><em>Document niet gevonden: @RelativePath</em></p>
    }
    else
    {
        @if (!_document.HasExplicitTitle)
        {
            <h1>@_document.Title</h1>
        }
        <article class="markdown-document">
            <CampaignReferenceContent Html="@(_renderedHtml ?? "<p><em>Laden...</em></p>")" />
        </article>
        @if (_locationMaps.Count > 0)
        {
            <LocationMaps Maps="_locationMaps" />
        }
    }
</div>

@code {
    [Parameter]
    public required string RelativePath { get; set; }

    private CampaignDocument? _document;
    private CampaignEntity? _location;
    private IReadOnlyList<string> _locationMaps = [];
    private string? _renderedHtml;

    protected override async Task OnParametersSetAsync()
    {
        await LoadDocumentAsync();
    }

    protected override void OnInitialized()
    {
        CampaignState.Changed += HandleChanged;
    }

    private async Task LoadDocumentAsync()
    {
        _document = CampaignState.Current?.FindDocument(RelativePath);
        _location = CampaignState.Current?.FindEntityForDocument(RelativePath);
        _renderedHtml = _document is not null && CampaignState.Current is not null
            ? await Renderer.RenderToHtmlAsync(_document, CampaignState.Current)
            : null;
        _locationMaps = _location?.Maps
            .Where(map => _renderedHtml is null || !ContainsImageReference(_renderedHtml, map))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray()
            ?? [];
    }

    private static bool ContainsImageReference(string html, string relativePath)
    {
        var fileName = Path.GetFileName(relativePath);
        return html.Contains(fileName, StringComparison.OrdinalIgnoreCase)
            || html.Contains(Uri.EscapeDataString(fileName), StringComparison.OrdinalIgnoreCase);
    }

    private async void HandleChanged()
    {
        await LoadDocumentAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CampaignState.Changed -= HandleChanged;
    }
}
