@implements IDisposable
@inject CampaignClientState CampaignState
@inject CampaignMarkdownRenderer Renderer

<PageTitle>@(_session?.Title ?? Slug)</PageTitle>

<div class="page-container">
    <a class="back-link" href="/">&larr; Terug naar overzicht</a>

    @if (CampaignState.Current is null)
    {
        <CampaignFolderPicker />
    }
    else if (_session is null)
    {
        <p><em>Sessie '@Slug' niet gevonden.</em></p>
    }
    else
    {
        <div class="session-view-header">
            <h1>@_session.Title</h1>
            <div class="session-view-controls" role="group" aria-label="Weergavemodus">
                <button type="button"
                        class="session-view-btn @(!_isOutlineCollapsed && !_isScriptCollapsed ? "is-active" : "")"
                        @onclick="ShowSplitView"
                        title="Gesplitste weergave (beide panelen)">
                    <span class="view-btn-icon">◫</span> Gesplitst
                </button>
                <button type="button"
                        class="session-view-btn @(!_isOutlineCollapsed && _isScriptCollapsed ? "is-active" : "")"
                        @onclick="ShowOutlineOnly"
                        title="Alleen outline tonen (volledig scherm)">
                    <span class="view-btn-icon">◧</span> Alleen outline
                </button>
                <button type="button"
                        class="session-view-btn @(_isOutlineCollapsed && !_isScriptCollapsed ? "is-active" : "")"
                        @onclick="ShowScriptOnly"
                        title="Alleen script tonen (volledig scherm)">
                    <span class="view-btn-icon">◨</span> Alleen script
                </button>
            </div>
        </div>

        <div class="split-pane @GetSplitPaneClass()">
            <div class="split-pane-column outline-column">
                <EditableDocument RelativePath="@($"Sessions/{Slug}/outline.md")" Html="@(_outlineHtml ?? "<p><em>Laden...</em></p>")">
                    <Header>
                        <h2>Outline (regie)</h2>
                    </Header>
                </EditableDocument>
            </div>
            <div class="split-pane-column script-column">
                <EditableDocument RelativePath="@($"Sessions/{Slug}/script.md")" Html="@(_scriptHtml ?? "<p><em>Laden...</em></p>")">
                    <Header>
                        <h2>Voorleesscript</h2>
                    </Header>
                </EditableDocument>
            </div>
        </div>

        @if (_recapHtml is not null)
        {
            <section class="recap-panel">
                <EditableDocument RelativePath="@($"Sessions/{Slug}/recap.md")" Html="@_recapHtml">
                    <Header>
                        <h2>Recap</h2>
                    </Header>
                </EditableDocument>
            </section>
        }

        <div class="live-notes">
            <h2>Live notities (voor de recap)</h2>
            @if (!string.IsNullOrWhiteSpace(_existingNotes))
            {
                <pre>@_existingNotes</pre>
            }
            <textarea @bind="_newNote" placeholder="Wat gebeurt er net aan tafel?"></textarea>
            <p><button @onclick="SaveNoteAsync">Toevoegen</button></p>
        </div>
    }
</div>

@code {
    [Parameter]
    public required string Slug { get; set; }

    private CampaignEntity? _session;
    private string? _outlineHtml;
    private string? _scriptHtml;
    private string? _recapHtml;
    private string? _existingNotes;
    private string _newNote = string.Empty;
    private bool _isOutlineCollapsed;
    private bool _isScriptCollapsed;

    private void ShowSplitView()
    {
        _isOutlineCollapsed = false;
        _isScriptCollapsed = false;
    }

    private void ShowOutlineOnly()
    {
        _isOutlineCollapsed = false;
        _isScriptCollapsed = true;
    }

    private void ShowScriptOnly()
    {
        _isOutlineCollapsed = true;
        _isScriptCollapsed = false;
    }

    private string GetSplitPaneClass()
    {
        if (_isOutlineCollapsed)
            return "is-outline-collapsed";
        if (_isScriptCollapsed)
            return "is-script-collapsed";
        return string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        LoadSession();
        await LoadDocumentsAsync();
        try
        {
            _existingNotes = _session is null ? null : await CampaignState.ReadNotesAsync(Slug);
        }
        catch
        {
            _existingNotes = null;
        }
    }

    protected override void OnInitialized()
    {
        CampaignState.Changed += HandleChanged;
    }

    private void LoadSession()
    {
        _session = CampaignState.Current?.FindSession(Slug);
    }

    private async void HandleChanged()
    {
        LoadSession();
        await LoadDocumentsAsync();
        try
        {
            _existingNotes = _session is null ? null : await CampaignState.ReadNotesAsync(Slug);
        }
        catch
        {
            _existingNotes = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDocumentsAsync()
    {
        _outlineHtml = await RenderDocumentAsync("outline");
        _scriptHtml = await RenderDocumentAsync("script");
        _recapHtml = await RenderOptionalDocumentAsync("recap");
    }

    private async Task<string?> RenderOptionalDocumentAsync(string fileName)
    {
        if (_session is null || !_session.Documents.TryGetValue(fileName, out var document))
            return null;

        try
        {
            return await Renderer.RenderToHtmlAsync(document, CampaignState.Current!);
        }
        catch
        {
            return null;
        }
    }

    private async Task<string> RenderDocumentAsync(string fileName)
    {
        if (_session is null || !_session.Documents.TryGetValue(fileName, out var document))
            return "<p><em>Nog niet aangemaakt.</em></p>";

        try
        {
            return await Renderer.RenderToHtmlAsync(document, CampaignState.Current!);
        }
        catch
        {
            return "<p><em>Kon document niet laden.</em></p>";
        }
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_newNote))
            return;

        await CampaignState.AppendNoteAsync(Slug, _newNote);
        _newNote = string.Empty;
        _existingNotes = await CampaignState.ReadNotesAsync(Slug);
    }

    public void Dispose()
    {
        CampaignState.Changed -= HandleChanged;
    }
}
